#!/bin/bash
# ============================================================
# Yuan VPS 工具箱 · 入口
# 安装后通过 `yuan` 命令进入
# ============================================================
export YUAN_ROOT="${YUAN_ROOT:-/opt/yuan-panel}"

if [[ ! -f "$YUAN_ROOT/src/common.sh" ]]; then
    echo "错误：面板文件损坏或未安装（$YUAN_ROOT 不存在）" >&2
    echo "请重新运行安装命令：" >&2
    echo "  bash <(curl -sL https://raw.githubusercontent.com/yuan1228/hy2/refs/heads/main/install.sh)" >&2
    exit 1
fi

# shellcheck disable=SC1091
source "$YUAN_ROOT/src/common.sh"
need_root

# shellcheck disable=SC1091
source "$YUAN_ROOT/src/menu.sh"
main_menu
